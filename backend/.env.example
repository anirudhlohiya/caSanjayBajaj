# App
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database (self-hosted PostgreSQL on EC2 in production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ca_sanjay_gst
DB_USER=postgres
DB_PASSWORD=
DB_LOGGING=false

# Auth (generate strong secrets, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AWS — IAM user `ca-backend` (S3 + SES + SNS)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_DOCS_BUCKET=ca-sanjay-gst-docs
S3_BACKUP_BUCKET=ca-sanjay-backups

# SES — verified email address or domain
SES_SOURCE_EMAIL=
SES_SOURCE_NAME=CA Sanjay Bajaj & Co.

# Firebase / FCM Web Push (VAPID keys from Firebase Cloud Messaging settings)
FIREBASE_PROJECT_ID=
FIREBASE_APP_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_VAPID_PUBLIC_KEY=
FIREBASE_VAPID_PRIVATE_KEY=
FIREBASE_VAPID_SUBJECT=mailto:admin@example.com

# Super Admin bootstrap (used by seed)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# Reminders
REMINDER_LEAD_DAYS=5
REMINDER_CRON=0 8 * * *

# CORS (comma-separated origins, or leave empty for all)
CORS_ORIGIN=