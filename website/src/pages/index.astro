---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---

<Base
  title="CA Sanjay Bajaj | Chartered Accountant in Surat | S N Bajaj And Co"
  description="S N Bajaj And Co — trusted Chartered Accountant firm in Surat for accounting, GST & income tax filing, auditing, loans and business compliance services. Precision, integrity and strategic financial guidance."
  canonical="/"
>
  <Header active="Home" />

  <!-- ================= HERO ================= -->
  <div class="hero section" id="Home">
    <div class="hero_title section_title">
      <div id="span">Chartered Accountant</div>
      <h1>
        I'm CA. Sanjay Bajaj Expert
        <span class="typewriter-container">
          <span id="text"></span>
        </span>
      </h1>
      <p>
        Trusted financial advisory, tax compliance, and auditing services in Surat and
        across Gujarat. Known for precision, integrity, and strategic insight, ensuring
        that individuals and businesses alike achieve financial clarity and sustainable
        growth.
      </p>
      <div class="btn_and_icon">
        <button class="btn">
          <a href="#Contact Us">Get Your Quote</a>
          <i class="ri-arrow-right-up-line"></i>
        </button>
        <div class="social_icon">
          <a href="https://www.facebook.com/share/172DEpVK9B/" target="_blank" rel="noopener" title="Facebook">
            <i class="ri-facebook-fill"></i>
          </a>
          <a href="https://www.instagram.com/sanju_baba143?igsh=dGloMGE4NDZ2MTdh" target="_blank" rel="noopener" title="Instagram">
            <i class="ri-instagram-fill"></i>
          </a>
          <a href="https://x.com/BajajSanju?t=x1buJScif34r17Jz4swNUQ&s=08" target="_blank" rel="noopener" title="Twitter/X">
            <i class="ri-twitter-x-fill"></i>
          </a>
          <a href="https://www.linkedin.com/in/ca-sanjay-bajaj-233188327?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app" target="_blank" rel="noopener" title="LinkedIn">
            <i class="ri-linkedin-fill"></i>
          </a>
        </div>
      </div>
      <div class="Online_clients">
        <pre style="color:#005bc2;">य एष सुप्तेषु जागर्ति कामं कामं पुरूषो निर्मिमाण :।
तदेव शुक्रं तद्‌ ब्रह्म तदेवामृतमुच्यते ।
तस्मिंल्लोका: श्रिता: सर्वे तदु नात्येति कश्चन | एतद्‌ वै तत्‌ ।।</pre>
      </div>
    </div>
    <div class="hero_image section_image">
      <img
        src="/images/ca-portrait.png"
        alt="CA Sanjay Bajaj — Chartered Accountant, S N Bajaj And Co, Surat"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- ================= FEATURES ================= -->
  <div class="Features section">
    <div class="Feature_item">
      <img src="/images/pc.png" alt="Professional consultancy icon" width="70" height="70" />
      <div class="Feature_item_content">
        <h3>Professional Consultancy</h3>
        <p>
          We provide expert guidance on financial structuring, regulatory compliance,
          business formation, and strategic growth planning to help you achieve your goals
          effectively.
        </p>
      </div>
    </div>

    <div class="Feature_item">
      <img src="/images/ea.png" alt="Expert advice icon" width="70" height="70" />
      <div class="Feature_item_content">
        <h3>Expert Advises</h3>
        <p>
          Get personalized advice on taxation, investment planning, and legal compliance
          from certified professionals, tailored to your individual or business needs.
        </p>
      </div>
    </div>

    <div class="Feature_item">
      <img src="/images/fp.png" alt="Financial planning icon" width="70" height="70" />
      <div class="Feature_item_content">
        <h3>Financial Planning</h3>
        <p>
          Our financial planning services cover everything from budgeting and cash flow
          management to tax-saving investments and retirement strategies — all designed to
          secure your financial future.
        </p>
      </div>
    </div>
  </div>

  <!-- ================= ABOUT ================= -->
  <div class="About section" id="About">
    <div class="About_Image section_image">
      <img src="/images/aboutca.jpg" alt="CA Sanjay Bajaj at work — S N Bajaj And Co office, Surat" loading="lazy" />
    </div>
    <div class="About_title section_title">
      <span class="span">About Me</span>
      <h2>S N BAJAJ AND CO.</h2>
      <p>
        I am CA Sanjay Bajaj, a Chartered Accountant with more than 10 years of
        professional experience, and the founder of S N Bajaj & Co., Surat. Over the years,
        I have built my practice on a strong foundation of integrity, accuracy, and
        client-first values, ensuring that every client receives not only compliance
        services but also strategic financial guidance tailored to their needs.
      </p>
      <p>
        At S N Bajaj & Co., my mission is simple: to deliver proactive, reliable, and
        expert financial services that create real value.
      </p>
      <div class="Contact_now">
        <button class="btn About_btn">
          <a href="#Contact Us">Get In Touch</a>
        </button>
      </div>
    </div>
  </div>

  <!-- ================= SERVICES ================= -->
  <div class="Services section" id="Services">
    <div class="Heading">
      <span>Our Services</span>
      <h2>"How Can I Help You"</h2>
    </div>
    <div class="Services_Cards">
      <div class="Service_Card">
        <img src="/images/bank.png" alt="Accounts service icon" height="60" width="60" loading="lazy" />
        <h2>Accounts</h2>
        <p>
          We offer expert accounting services, helping businesses maintain accurate
          records, prepare financial statements, and stay compliant with statutory
          requirements.
        </p>
      </div>

      <div class="Service_Card">
        <img src="/images/tax.png" alt="Taxation service icon" height="60" width="60" loading="lazy" />
        <h2>Taxes</h2>
        <p>
          Comprehensive assistance with GST registration, GST returns, and income tax
          filing to ensure your tax obligations are met efficiently and on time.
        </p>
      </div>

      <div class="Service_Card">
        <img src="/images/loan.png" alt="Loan assistance icon" height="60" width="60" loading="lazy" />
        <h2>Loan</h2>
        <p>
          Get end-to-end support for Personal, Home, Term, Machinery, and Mortgage Loans —
          from documentation to approval.
        </p>
      </div>

      <div class="Service_Card">
        <img src="/images/finance.png" alt="Finance advisory icon" height="60" width="60" loading="lazy" />
        <h2>Finance</h2>
        <p>
          Financial advisory for better investments including Mutual Funds, CMA Reports,
          and funding strategies for business growth.
        </p>
      </div>

      <div class="Service_Card">
        <img src="/images/business.png" alt="Business services icon" height="60" width="60" loading="lazy" />
        <h2>Business Services</h2>
        <p>
          Professional services like PAN/TAN applications, Digital Signature (DSC), Trade
          Mark registration, and IEC Code to set up and run your business smoothly.
        </p>
      </div>

      <div class="Service_Card">
        <img src="/images/services.png" alt="Other services icon" height="60" width="60" loading="lazy" />
        <h2>Other Services</h2>
        <p>
          We also assist with LIC insurance plans and a range of additional compliance and
          financial services tailored to your needs.
        </p>
      </div>
    </div>
  </div>

  <!-- ================= TESTIMONIALS ================= -->
  <div class="Testimonials section">
    <div class="Heading">
      <span>Testimonials</span>
      <h2>Clients Reviews</h2>
    </div>
    <div class="splide Testimonials_Splide" aria-label="Client testimonials">
      <div class="splide__track">
        <ul class="splide__list">
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Top-Notch Service</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>S N Bajaj And Co stands out as an excellent choice for banking and finance services. With their experienced team, they ensure a seamless experience with minimal formalities. Their professionalism and attention to detail make them a reliable partner for all financial needs. Highly recommended for anyone looking for efficient financial solutions!</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Narendra Agarwal</h2>
                  <p>S K Property</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Reliable</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>I am very pleased with the tax filing service provided by Mr.Sanjay.He is very professional communicate very well and made sure all of my questions were answered. My taxes were filed accurately and on time. I would highly recommend their services to anyone looking for reliable tax assistance.</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Rahul Mistry</h2>
                  <p>Vruddhi Finserv</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Excellent Interaction</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>I had a great experience with S N Bajaj And Co, a company that helps with banking and finance. They gave me a proper explanation of their services, which made everything clear. The staff was very experienced and knew what they were talking about. Their approach was realistic, so I felt confident in their advice. Overall, it was an excellent interaction!</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Ranjeet Kumar</h2>
                  <p>R K Trading</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Financial Guidance</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>My experience at S N Bajaj And Co was excellent. The team provided a realistic approach to my financial needs, ensuring I understood every detail of their services, and their professionalism instilled confidence in my decisions. I highly recommend them for anyone seeking reliable financial guidance.</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Madhusudan Lakhotia</h2>
                  <p>Business</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Best Services</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>SN Bajaj provides best services and helps regarding GST. And they tell you how to reduce your tax while filling Income Tax.</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Swaroop Daiya</h2>
                  <p>Tryon Infosoft</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Smooth & Hassle-free</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>I had an excellent experience with S N Bajaj And Co. The team provided a proper explanation of the services offered, which made the entire process smooth and hassle-free. Additionally, their location is easily accessible, making visits convenient. I highly recommend S N Bajaj And Co for anyone seeking reliable assistance!</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Vishal Baghel</h2>
                  <p>Client</p>
                </div>
              </div>
            </div>
          </li>
          <li class="splide__slide">
            <div class="test_slide">
              <div class="test_head">
                <h2>Clarity & Precision</h2>
                <div class="stars">
                  <i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i><i class="ri-star-fill"></i>
                </div>
              </div>
              <p>I've been working with Sanjay Bajaj for several years now, and his expertise and professionalism have been invaluable to managing my finances and business compliance. He is extremely knowledgeable, detail-oriented, and always up-to-date with the latest tax laws and regulations. I truly trust his judgment and highly recommend his services to anyone looking for a reliable and competent Chartered Accountant.</p>
              <div class="client_det">
                <div class="client_info">
                  <h2>Bharat Singh Kelawat</h2>
                  <p>Suraj Air Express</p>
                </div>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ================= CONTACT ================= -->
  <div class="Contact section" id="Contact Us">
    <div class="Contact_title section_title">
      <div class="Contact_Headings Heading">
        <span class="contact_us">Contact Us</span>
        <h2 class="contact_us">Reach Out Today</h2>
      </div>
      <div class="Contact_Details">
        <div class="Contact_Det">
          <i class="ri-phone-line"></i>
          <div class="Contact_Info">
            <p>Phone</p>
            <h2>+91 99098 31995</h2>
          </div>
        </div>
        <div class="Contact_Det">
          <i class="ri-mail-line"></i>
          <div class="Contact_Info">
            <p>Email</p>
            <a href="mailto:casnbajaj2015@gmail.com" style="text-decoration: none; color: inherit;">
              <h2>casnbajaj2015@gmail.com</h2>
            </a>
          </div>
        </div>
        <div class="Contact_Det">
          <i class="ri-map-pin-line"></i>
          <div class="Contact_Info">
            <p>Address</p>
            <a href="https://maps.app.goo.gl/4NhEy5wMpAyFHKyd6?g_st=aw" target="_blank" rel="noopener" style="text-decoration: none; color: inherit;">
              <h2>2007,Trade House, Opp. MAN DARWAJA FIRE STATION, RING ROAD, SURAT-395002</h2>
            </a>
          </div>
        </div>
      </div>
    </div>
    <EnquiryForm />
  </div>

  <Footer />

  <!-- Third-party widgets + initialisers (globals used by bundled script below) -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/typed.js/2.0.10/typed.js" integrity="sha512-tQQXRDB2wEmuJGtFrmmoFYzNTq8StA1XJrfO0OQbbTxd9G0CwaTDL6/C1y805IlvBVrMwOqob1kf6r/2U5XXVg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

  <script>
    // Testimonials slider
    const slider = document.querySelector('.Testimonials_Splide');
    if (slider) {
      new Splide(slider, {
        type: 'loop',
        perPage: 3,
        gap: '2rem',
        pagination: false,
        rewind: true,
        breakpoints: {
          1600: { perPage: 2.5 },
          1400: { perPage: 2 },
          1000: { perPage: 1 },
          768: { perPage: 1 },
        },
      }).mount();
    }

    // Hero typewriter
    const typeTarget = document.querySelector('#text');
    if (typeTarget && typeof Typed !== 'undefined') {
      new Typed('#text', {
        strings: ['Accountant', 'Consultancy', 'Advisor'],
        typeSpeed: 50,
        backSpeed: 50,
        loop: true,
      });
    }
  </script>
</Base>
